# Base URL for API calls. Keep "/api/v1" in development (proxied by Vite).
VITE_API_BASE_URL=/api/v1
# Where the Vite dev server proxies /api to
VITE_DEV_API_PROXY=http://localhost:8000
# Google OAuth "Web application" client ID (same as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
