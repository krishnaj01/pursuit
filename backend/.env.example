# Postgres connection string (postgres://, postgresql:// and postgresql+asyncpg:// all work)
DATABASE_URL=postgresql://user:password@localhost:5432/job_tracker

# Google OAuth "Web application" client ID (same value as the frontend's VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRE_MINUTES=10080
COOKIE_SECURE=false

# Comma-separated when several frontends call the API directly
FRONTEND_ORIGIN=http://localhost:5173

# https://logo.dev — publishable key (pk_...) is used server-side to fetch each logo once (cached in the DB);
# the secret key (sk_...) is optional and enables brand search for company name -> domain
LOGO_DEV_PUBLISHABLE_KEY=
LOGO_DEV_SECRET_KEY=
